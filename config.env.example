# Reth & Lighthouse Monitoring Configuration

# Slack Webhook URL (Required)
# Get this from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL="YOUR_SLACK_WEBHOOK_URL_HERE"

# Reth Configuration
RETH_ENGINE_PORT=8551
RETH_LOG_FILE="/home/ubuntu/reth/logs/reth.log"

# Lighthouse Configuration
LIGHTHOUSE_HTTP_PORT=5052
LIGHTHOUSE_LOG_FILE="/home/ubuntu/.lighthouse/beacon/logs/beacon.log"
LIGHTHOUSE_P2P_PORT=9000

# Monitoring Logs Directory
LOG_DIR="/home/ubuntu/reth-monitoring/logs"
